# Public site origin used for canonical/social metadata and sitemap URLs.
# Keep the live Vercel origin until adstele.in is purchased, connected, and live.
VITE_SITE_URL=https://adstele.vercel.app

# Meta Pixel browser ID (not a secret). Leave empty until you are ready to enable the Pixel.
VITE_META_PIXEL_ID=

# Optional public map from UTM campaign/source to unique Telegram invite links.
# Example: {"meta-campaign-a":"https://t.me/+INVITE","source:meta":"https://t.me/+META_INVITE","default":"https://t.me/adstele_agency"}
VITE_TELEGRAM_INVITE_LINKS=
